def maximumProduct(nums: List[int]) -> int:
    nums.sort()

    ans1 = nums[len(nums)-1] * nums[len(nums)-2] * nums[len(nums)-3]
    ans2 = nums[0] * nums[1] * nums[len(nums)-1]

    if ans1 >= ans2:
        return ans1
    elif ans2 > ans1:
        return ans2

nums = [1,2,3]
print(maximumProduct(nums))